{
  "chat.mcp.gallery.enabled": true,
  "editor.fontFamily": "FiraCode Nerd Font, Fira Code, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "prettier.requireConfig": true,
  "editor.tabSize": 2,
  "files.trimTrailingWhitespace": true,
  "hexeditor.columnWidth": 32,
  "hexeditor.showDecodedText": true,
  "hexeditor.defaultEndianness": "little",
  "hexeditor.inspectorType": "aside",
  "remote.SSH.remotePlatform": {
    "foundry.famille-savin.com": "linux",
    "pi5-n8n": "linux",
    "192.168.1.151": "linux"
  },
  "security.allowedUNCHosts": ["nas"],
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "FiraCode Nerd Font, 'Fira Code Nerd Font', 'Fira Code', monospace",
  "workbench.iconTheme": "vscode-icons",
  "workbench.tree.indent": 10,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "diffEditor.renderSideBySide": true,
  "chat.tools.terminal.autoApprove": {
    "upower": true,
    "true": true,
    "/bin/cat": true,
    "ip": true,
    "ping": true,
    "resolvectl": true,
    "dig": true,
    "arp": true,
    "Get-MpPreference": true,
    "Get-MpComputerStatus": true,
    "Get-CimInstance": true,
    "Select": true,
    "Get-WinEvent": true,
    "else": true
  },
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "git.enableSmartCommit": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.experimental.showMoves": true,
  "git.autofetch": true,
  "claudeCode.preferredLocation": "panel",
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://www.amazon.fr": true,
    "https://www.aliexpress.com": {
      "approveRequest": true,
      "approveResponse": false
    },
    "https://www.meilleursmobilesnumeriques.fr": true,
    "https://*.meilleursmobilesnumeriques.fr": true,
    "https://domotique-info.fr": true,
    "https://www.domadoo.fr": true,
    "https://*.domadoo.fr": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "vsicons.dontShowNewVersionMessage": true,
  "github.copilot.chat.localIndex.enabled": true,
  "claudeCode.disableLoginPrompt": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.byokUtilityModelDefault": "mainAgent",
  "deepseek-copilot.visionModel": "deepseek/deepseek-v4-flash-vision-exp"
}
