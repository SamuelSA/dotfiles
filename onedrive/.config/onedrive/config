# OneDrive Client for Linux - user configuration
# Stow-managed from ~/.dotfiles/onedrive. Edit this source file, not the live path.
# For the full option list: https://github.com/abraunegg/onedrive/blob/master/docs/application-config-options.md

# Local sync root.
sync_dir = "~/OneDrive"

# Move online deletions to the desktop trash instead of deleting local files.
use_recycle_bin = "true"

# These files are not worth syncing. We re-declare the defaults because
# skip_file replaces the built-in list.
skip_file = "~*|.~*|*.tmp|*.swp|*.partial|desktop.ini|*.lnk|.DS_Store|*-safeBackup-*"

# Ignore generated caches, virtualenvs, and build output within the sync root.
skip_dir = "node_modules|__pycache__|.venv|venv|.pytest_cache|.mypy_cache|.ruff_cache|.tox|bin|obj"

# Keep CPU usage reasonable on a 4-core Pi.
threads = "4"
